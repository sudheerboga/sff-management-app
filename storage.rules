rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /boutiques/{boutiqueId}/{allPaths=**} {
      function isSuperAdmin() {
        return firestore.exists(/databases/(default)/documents/superAdmins/$(request.auth.uid));
      }
      function isBoutiqueMember() {
        let u = firestore.get(/databases/(default)/documents/boutiqueUsers/$(request.auth.uid)).data;
        return u.boutiqueId == boutiqueId && u.isActive == true;
      }
      allow read:  if request.auth != null && (isSuperAdmin() || isBoutiqueMember());
      allow write: if request.auth != null && (isSuperAdmin() || isBoutiqueMember());
    }
  }
}
