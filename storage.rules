rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /boutiques/{boutiqueId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && firestore.exists(
                        /databases/(default)/documents/boutiqueUsers/$(request.auth.uid)
                      );
    }
  }
}
