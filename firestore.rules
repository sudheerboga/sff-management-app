rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    function getBoutiqueUser() {
      return get(/databases/$(database)/documents/boutiqueUsers/$(request.auth.uid)).data;
    }

    function isAdminOf(boutiqueId) {
      let u = getBoutiqueUser();
      return u.boutiqueId == boutiqueId && u.role == 'admin' && u.isActive == true;
    }

    function isMemberOf(boutiqueId) {
      let u = getBoutiqueUser();
      return u.boutiqueId == boutiqueId && u.isActive == true;
    }

    // ── Super Admins ──────────────────────────────────────────
    match /superAdmins/{uid} {
      allow read: if request.auth.uid == uid || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ── Subscription Plans (read-only for all auth users) ────
    match /subscriptionPlans/{planId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // ── Subscription Payments ────────────────────────────────
    match /subscriptionPayments/{paymentId} {
      allow read, write: if isSuperAdmin();
    }

    // ── Boutiques ─────────────────────────────────────────────
    match /boutiques/{boutiqueId} {
      allow read:   if isSuperAdmin() || isMemberOf(boutiqueId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isAdminOf(boutiqueId);
      allow delete: if isSuperAdmin();

      match /orders/{orderId} {
        allow read:   if isSuperAdmin() || isMemberOf(boutiqueId);
        allow create: if isSuperAdmin() || isMemberOf(boutiqueId);
        allow update: if isSuperAdmin() || isMemberOf(boutiqueId);
        allow delete: if isSuperAdmin() || isAdminOf(boutiqueId);
      }

      match /measurements/{measId} {
        allow read:   if isSuperAdmin() || isMemberOf(boutiqueId);
        allow create: if isSuperAdmin() || isMemberOf(boutiqueId);
        allow update: if isSuperAdmin() || isMemberOf(boutiqueId);
        allow delete: if isSuperAdmin() || isAdminOf(boutiqueId);
      }

      match /billing/{billId} {
        allow read:   if isSuperAdmin() || isMemberOf(boutiqueId);
        allow create: if isSuperAdmin() || isMemberOf(boutiqueId);
        allow update: if isSuperAdmin() || isAdminOf(boutiqueId);
        allow delete: if isSuperAdmin() || isAdminOf(boutiqueId);
      }

      match /customers/{customerId} {
        allow read:   if isSuperAdmin() || isMemberOf(boutiqueId);
        allow create: if isSuperAdmin() || isMemberOf(boutiqueId);
        allow update: if isSuperAdmin() || isMemberOf(boutiqueId);
        allow delete: if isSuperAdmin() || isAdminOf(boutiqueId);
      }

      match /measurementTemplates/{templateId} {
        allow read:   if isSuperAdmin() || isMemberOf(boutiqueId);
        allow create: if isSuperAdmin() || isAdminOf(boutiqueId);
        allow update: if isSuperAdmin() || isAdminOf(boutiqueId);
        allow delete: if isSuperAdmin() || isAdminOf(boutiqueId);
      }

      match /deletedRecords/{recordId} {
        allow read:  if isSuperAdmin() || isAdminOf(boutiqueId);
        allow write: if isSuperAdmin() || isMemberOf(boutiqueId);
      }
    }

    // ── Boutique Users ────────────────────────────────────────
    match /boutiqueUsers/{uid} {
      allow read: if request.auth.uid == uid
                  || isSuperAdmin()
                  || (exists(/databases/$(database)/documents/boutiqueUsers/$(request.auth.uid))
                      && getBoutiqueUser().boutiqueId == resource.data.boutiqueId
                      && getBoutiqueUser().role == 'admin');
      allow create: if isSuperAdmin()
                    || request.auth.uid == uid;
      allow update: if isSuperAdmin()
                    || (getBoutiqueUser().boutiqueId == resource.data.boutiqueId
                        && getBoutiqueUser().role == 'admin');
      allow delete: if isSuperAdmin();
    }

    // ── Staff Invites ─────────────────────────────────────────
    match /staffInvites/{phone} {
      allow read: if isSuperAdmin()
                  || (request.auth != null && request.auth.token.phone_number == phone)
                  || (exists(/databases/$(database)/documents/boutiqueUsers/$(request.auth.uid))
                      && isAdminOf(getBoutiqueUser().boutiqueId));
      allow create,update: if isSuperAdmin()
                    || (exists(/databases/$(database)/documents/boutiqueUsers/$(request.auth.uid))
                        && isAdminOf(getBoutiqueUser().boutiqueId));
      allow delete: if isSuperAdmin()
                    || request.auth.token.phone_number == phone;
    }
  }
}
